{
  "name": "@ledger-lens/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Ledger Lens for iPhone: Pay from pasted text, the ФОП report and monobank, all on the phone. No server.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo-doctor",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --latest"
  },
  "dependencies": {
    "@ledger-lens/contracts": "*",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.0",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14"
  }
}
