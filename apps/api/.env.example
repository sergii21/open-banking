# Nothing here is needed to run the app on your own computer: `./start.sh` works without a .env file.
# Copy to apps/api/.env (git-ignored) only to change something. Real environment variables always win over this file.
# Never commit secrets and never paste a bank token anywhere except into the app.

# Where the app is served from. The default is http://localhost:<PORT>. Real bank accounts can only be connected
# while this is a localhost address (set ALLOW_LIVE_PROVIDERS=true to override that on purpose).
# PUBLIC_URL=http://localhost:3000
# PORT=3000
# HOST=127.0.0.1

# Database and the keys that seal your token live in <repo>/data (git-ignored). The keys are created on the first run with
# owner-only permissions; there is no key in the code. To use your own, set both (and then the file is not used):
# DATA_DIR=./data
# SESSION_SECRET=      # openssl rand -base64 48
# TOKEN_ENCRYPTION_KEY=   # openssl rand -base64 32

# How long a browser stays signed in to its data (days).
# SESSION_TTL_DAYS=365

# monobank
# MONOBANK_HISTORY_MONTHS=2         # how much history the background loader fetches (1-13)
# MONOBANK_MIN_INTERVAL_SECONDS=61  # monobank allows one read a minute per endpoint; do not go lower with a real token
# TIME_ZONE=Europe/Kyiv             # days and months are cut in this zone

# PrivatBank business accounts (the Autoclient API). Personal cards come in through a statement file instead.
# PRIVATBANK_HISTORY_MONTHS=2       # how much history the background loader fetches (1-13)
# PRIVATBANK_MIN_INTERVAL_MS=1100   # the bank asks for at most one request a second; do not go lower with a real key
# PRIVATBANK_API_URL=https://acp.privatbank.ua   # only to point the app at the local fake (npm run fake:privatbank)

# The demo bank
# DEMO_INTERVAL_SECONDS=0           # 0 loads the whole demo at once; 20 shows what the paced real thing feels like
# DEMO_REAL_RATES=true              # the demo shows the real bank's public exchange rates when it can reach them

# Logging: warn by default when built, info in development.
# LOG_LEVEL=info
