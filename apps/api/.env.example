# Copy to apps/api/.env (git-ignored). Real environment variables always win over this file.
# Never commit secrets. Never paste them into chat.

# --- Core -------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Origin the browser uses. In `npm run dev` that is the Angular dev server (it proxies /api and /mock-bank).
# For `npm start` / production, set it to the public https URL: provider redirects and cookies derive from it.
PUBLIC_URL=http://localhost:4200
DATABASE_PATH=./data/ledger-lens.db
LOG_LEVEL=info

# Required in production. Generate with:  openssl rand -base64 48
# SESSION_SECRET=
# Required in production (32 bytes, base64). Generate with:  openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=

# Enabled adapters, comma separated: mock, truelayer. An adapter without credentials is skipped with a warning.
PROVIDERS=mock

# Mock-bank demo panel (force an outage, revoke at the bank, expire consent). On by default outside production.
# DEMO_CONTROLS=true

# --- Limits ------------------------------------------------------------------------------------------
# MAX_PAYMENT_MINOR=500000        # largest payment accepted, in minor units (sandbox cap is 5,000,000)
# REFRESH_COOLDOWN_SECONDS=20     # minimum gap between user-initiated refreshes of one account
# RATE_LIMIT_PER_MINUTE=600       # per-IP ceiling; sensitive routes add tighter per-session limits
# SESSION_CREATES_PER_MINUTE=30   # new anonymous sessions one address may start per minute
# TRUST_PROXY=true                # set behind a reverse proxy (Render, nginx) so req.ip is the client

# --- TrueLayer sandbox (milestones M2/M3) ----------------------------------------------------------
# Sandbox only: Ledger Lens never talks to TrueLayer's live environment.
#
# 1. Create a free account at console.truelayer.com and keep the "Live" toggle OFF.
# 2. Create an app, copy its sandbox credentials below, and add this exact redirect URI to the app:
#      {PUBLIC_URL}/api/connections/callback        e.g. http://localhost:4200/api/connections/callback
#    (for payments also add {PUBLIC_URL}/api/payments/return as a payments redirect URI).
# 3. Add `truelayer` to PROVIDERS above.
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
#
# Which TrueLayer mock bank the auth dialog offers. `uk-cs-mock` is the one documented for the Data API sandbox;
# if the dialog says the provider is unknown, try `mock`.
# TRUELAYER_DATA_PROVIDERS=uk-cs-mock
#
# Payments v3 signs every request. Run `npm run keys:truelayer`, upload the printed PUBLIC key in the Console
# (Payments > Signing keys), then paste the key id it shows and the private key location:
# TRUELAYER_SIGNING_KEY_ID=
# TRUELAYER_PRIVATE_KEY_PATH=./.secrets/truelayer-signing-private.pem
# ...or, on a host where you cannot mount a file, the PEM itself with newlines written as \n:
# TRUELAYER_PRIVATE_KEY=
#
# Where a payment goes. A new sandbox app has a merchant account per currency (Console > Merchant account);
# paste each id. This is the default and works out of the box.
# TRUELAYER_BENEFICIARY=merchant_account
# TRUELAYER_MERCHANT_ACCOUNT_ID_GBP=
# TRUELAYER_MERCHANT_ACCOUNT_ID_EUR=
# Paying an arbitrary IBAN / sort code needs payments to external accounts enabled for your app by TrueLayer:
# TRUELAYER_BENEFICIARY=external_account
#
# Sandbox mock banks used to approve payments (override only if TrueLayer renames them):
# TRUELAYER_PAYMENT_PROVIDER_GBP=mock-payments-gb-redirect
# TRUELAYER_PAYMENT_PROVIDER_EUR=mock-payments-de-redirect
# TRUELAYER_USER_EMAIL=demo@ledger-lens.example

# --- monobank (Ukraine, real accounts, personal use only) -----------------------------------------
# Reads YOUR OWN accounts with a read-only token you issue at https://api.monobank.ua/ and paste into the app (never into
# chat or a file). Local only: it stays off while PUBLIC_URL is not localhost. Details: docs/UKRAINE.md
# PROVIDERS=mock,monobank
# MONOBANK_HISTORY_MONTHS=3             # background history, one statement request per minute per account and month
# ALLOW_LIVE_PROVIDERS=false            # true switches live providers on for a non-localhost PUBLIC_URL: do not
# Test-only knobs (the e2e run points these at a local fake of the bank):
# MONOBANK_API_URL=https://api.monobank.ua
# MONOBANK_MIN_INTERVAL_SECONDS=61

# --- Payments and webhooks --------------------------------------------------------------------------
# Payments waiting for approval at the bank expire after this long (TrueLayer's resource token lasts 15 minutes).
# PAYMENT_APPROVAL_MINUTES=15
# The mock bank takes this long between the steps of a payment (authorised, executed, settled).
# MOCK_BANK_STEP_SECONDS=3
# A webhook claiming to be older than this is refused (TrueLayer retries for up to 72 hours).
# WEBHOOK_MAX_AGE_SECONDS=259800
#
# TrueLayer tells us about each payment step by webhook: register  {PUBLIC_URL}/api/webhooks/truelayer  in the Console
# (Webhooks) and run a tunnel (cloudflared or ngrok) so TrueLayer can reach it. Without one nothing breaks: the app polls
# every few seconds for payments it has not heard about, and again when the customer returns from the bank.
